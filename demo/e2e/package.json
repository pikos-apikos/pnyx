{
  "name": "pnyx-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright end-to-end tests for the Pnyx civic reasoning platform",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "^26.1.2",
    "typescript": "7.0.2"
  }
}
