<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
    <property name="severity" value="warning"/>
    <property name="charset" value="UTF-8"/>

    <module name="TreeWalker">
        <!-- Require Javadoc on all public API/SPI methods (contracts visible to other modules) -->
        <module name="MissingJavadocMethod">
            <property name="scope" value="public"/>
            <property name="minLineCount" value="1"/>
            <property name="allowedAnnotations" value="Override,Test,BeforeEach,AfterEach,BeforeAll,AfterAll"/>
            <property name="tokens" value="METHOD_DEF,ANNOTATION_FIELD_DEF,COMPACT_CTOR_DEF"/>
        </module>

        <!-- Require Javadoc on public classes/interfaces/enums -->
        <module name="MissingJavadocType">
            <property name="scope" value="public"/>
        </module>

        <!-- Javadoc must be well-formed -->
        <module name="JavadocStyle">
            <property name="checkFirstSentence" value="false"/>
            <property name="checkHtml" value="false"/>
        </module>

        <!-- Ensure @param, @return, @throws are present -->
        <module name="JavadocMethod">
            <property name="accessModifiers" value="public"/>
            <property name="validateThrows" value="true"/>
        </module>
    </module>
</module>